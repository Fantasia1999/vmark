{
  "name": "vscode-md-preview",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension: VS Code-style Markdown Open as Preview",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:e2e": "node test/e2e-links.test.mjs",
    "smoke": "node scripts/smoke-render.mjs",
    "icons": "python3 scripts/generate-icons.py",
    "ssh-bridge": "npm --prefix ssh-bridge start",
    "ssh-bridge:install": "npm --prefix ssh-bridge install",
    "diagnose:ssh": "node scripts/diagnose-ssh-workspace.mjs"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.2",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.6.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.1",
    "esbuild": "^0.25.5",
    "playwright": "^1.62.0",
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
