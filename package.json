{
  "name": "vscode-md-preview",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension: VS Code-style Markdown Open as Preview",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-render.mjs"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.2",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.6.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "@types/markdown-it": "^14.1.2",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
